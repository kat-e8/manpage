# Copy this file to .env and adjust as needed.
# .env is gitignored; these are safe defaults for local-only use.

# --- Postgres ---
POSTGRES_USER=codercommands
POSTGRES_PASSWORD=codercommands
POSTGRES_DB=codercommands

# Published so a remote postgres-mcp (e.g. clubuntu's) can reach this
# machine's postgres via a per-call connection_uri override. Left at
# loopback by default -- closed unless you set your own Tailscale IP here.
# Not 5432 -- that's already taken locally by the unrelated ../POSTGRES
# project's own container.
POSTGRES_TAILNET_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433

# --- Sync service ---
# Path to the source workbook, mounted read-only into the sync container.
XLSX_HOST_PATH=./coder_commands.xlsx
SYNC_POLL_SECONDS=7

# --- coder-commands-mcp ---
# The coder-commands lookup server (search_commands, list_topics,
# browse_<topic>) -- named for what it is, not "mcp-server" as if it were
# the only one. Also not published to the host -- reached only via the
# gateway, internally at http://coder-commands-mcp:9000 (set directly in
# docker-compose.yml).

# --- docker-mcp ---
# This project's own copy (./docker-mcp). Its default engine is always the
# host's own Docker socket (bind-mounted directly in docker-compose.yml, not
# via an env var). These two paths are only for *per-call* docker_host=
# "ssh://..." overrides that reach *other* tailnet nodes' engines -- see
# DOCKER_HOST_PROPERTY in docker-mcp/src/docker_mcp/server.py.
#
# Both point at files that live outside this repo, on whatever host actually
# runs docker-mcp (currently clubuntu) -- never commit an actual private key.
# Setup for a new target host, e.g. adding a third tailnet node:
#   1. ssh-keygen -t ed25519 -f ~/.ssh/docker_mcp_ed25519 -N '' on the host
#      running docker-mcp (one shared keypair, reused across target hosts).
#   2. Append the .pub to ~/.ssh/authorized_keys on the target host, for a
#      *non-admin* account in that host's docker group / docker-users group
#      (see project_docker_mcp_ssh_katlegog memory for why this matters on
#      Windows -- admin accounts route through administrators_authorized_keys,
#      which is a known source of silent connection resets on Win32-OpenSSH).
#   3. From the docker-mcp host, `ssh -o StrictHostKeyChecking=accept-new
#      <user>@<target>` once to pin the host key into DOCKER_MCP_SSH_KEY_PATH's
#      known_hosts -- this repo intentionally does NOT auto-accept unknown
#      host keys from inside the container (see docker-mcp/ssh_config).
# Absolute paths required -- docker-compose does not expand ~ in bind mounts.
DOCKER_MCP_SSH_KEY_PATH=/home/youruser/.ssh/docker_mcp_ed25519
DOCKER_MCP_SSH_KNOWN_HOSTS_PATH=/home/youruser/.ssh/known_hosts

# --- git-mcp ---
# This project's own copy (./git-mcp). Unlike docker-mcp/postgres-mcp,
# there is no local default target -- this container has no meaningful
# repos of its own, so every tool call must name a `target`, resolved
# against the registry below. See git-mcp/design-plan.pdf for the full
# design and git-mcp/README.md for the tool inventory.
#
# Own dedicated keypair (separate from docker-mcp's, for blast-radius
# separation), reusing the same already-provisioned service accounts on
# each target host by adding a second authorized_keys entry -- no new
# accounts needed. Setup for a new target host, e.g. adding a fourth
# tailnet node:
#   1. ssh-keygen -t ed25519 -f ~/.ssh/git_mcp_ed25519 -N '' on the host
#      running git-mcp (one shared keypair, reused across target hosts).
#   2. Append the .pub to ~/.ssh/authorized_keys for the SAME account
#      docker-mcp already uses on that host (docker-mcp-svc on katlegog,
#      katlego on katmint; on clubuntu itself, its own account, for the
#      self-loop entry below).
#   3. From the git-mcp host, `ssh -o StrictHostKeyChecking=accept-new
#      <user>@<target>` once to pin the host key -- known_hosts can be
#      shared with DOCKER_MCP_SSH_KNOWN_HOSTS_PATH (it's not secret) or
#      kept separate.
# Absolute paths required -- docker-compose does not expand ~ in bind mounts.
GIT_MCP_SSH_KEY_PATH=/home/youruser/.ssh/git_mcp_ed25519
GIT_MCP_SSH_KNOWN_HOSTS_PATH=/home/youruser/.ssh/known_hosts
# Registry of target aliases every git-mcp tool call must name explicitly.
# "os" selects shell-safe quoting: "posix" (shlex-style) or "windows"
# (cmd.exe-style) -- getting this wrong for a target is a real injection
# risk, not just a formatting detail (see git_mcp/quoting.py). A new
# "windows" target should NOT be enabled here until windows_quote() has
# been verified against real cmd.exe metacharacters on that specific
# target first (see "Staged rollout" in git-mcp/design-plan.pdf) --
# katlegog below was verified this way on 2026-08-16 (final-run/07) before
# being added; don't copy this entry as a template for a *different*
# Windows host without repeating that verification.
GIT_MCP_TARGETS={"clubuntu":{"ssh":"<user>@clubuntu","os":"posix"},"katmint":{"ssh":"katlego@katmint","os":"posix"},"katlegog":{"ssh":"docker-mcp-svc@katlegog","os":"windows"}}

# --- postgres-mcp ---
# This project's own service (./postgres-mcp), not a separate compose
# project. Also not published to the host -- reached only via the gateway,
# internally at http://postgres-mcp:8000. Its DATABASE_URL is built from the
# same POSTGRES_USER/PASSWORD/DB vars above (set directly in
# docker-compose.yml), so it defaults to this project's own `postgres`
# service; a connection_uri passed to any of its tools overrides that for
# just that one call.

# --- gateway (the one service published to the host) ---
# Generic MCP gateway, not coder-commands-specific -- mounts whatever
# upstream MCP servers this project has (currently coder-commands-mcp,
# docker-mcp, postgres-mcp, git-mcp) behind this one published port.
GATEWAY_HOST_PORT=8100

# Required. Every proxied MCP route (everything except /healthz) rejects
# requests unless the caller sends this exact value in an X-API-Key header --
# docker-mcp holds the host's Docker socket, so an unset key fails closed
# rather than running the gateway open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=
