# Copy this file to .env and adjust as needed.
# .env is gitignored; these are safe defaults for local-only use.

# --- Postgres ---
# Not published to the host (docker-compose.yml has no `ports:` entry for
# it) -- this machine already runs an unrelated Postgres container on the
# default 5432, and nothing outside the compose network needs to reach this
# one directly. Internal port is always 5432, so it isn't a variable here.
POSTGRES_USER=codercommands
POSTGRES_PASSWORD=codercommands
POSTGRES_DB=codercommands

# --- Sync service ---
# Path to the source workbook, mounted read-only into the sync container.
XLSX_HOST_PATH=./coder_commands.xlsx
SYNC_POLL_SECONDS=7

# --- coder-commands-mcp ---
# The coder-commands lookup server (search_commands, list_topics,
# browse_<topic>) -- named for what it is, not "mcp-server" as if it were
# the only one. Also not published to the host -- reached only via the
# gateway, internally at http://coder-commands-mcp:9000 (set directly in
# docker-compose.yml).

# --- postgres-mcp ---
# This project's own service (./postgres-mcp), not a separate compose
# project. Also not published to the host -- reached only via the gateway,
# internally at http://postgres-mcp:8000. Its DATABASE_URL is built from the
# same POSTGRES_USER/PASSWORD/DB vars above (set directly in
# docker-compose.yml), so it defaults to this project's own `postgres`
# service; a connection_uri passed to any of its tools overrides that for
# just that one call.

# --- gateway (the one service published to the host) ---
# Generic MCP gateway, not coder-commands-specific -- mounts whatever
# upstream MCP servers this project has (currently coder-commands-mcp,
# docker-mcp, postgres-mcp) behind this one published port.
GATEWAY_HOST_PORT=8100

# Required. Every proxied MCP route (everything except /healthz) rejects
# requests unless the caller sends this exact value in an X-API-Key header --
# docker-mcp holds the host's Docker socket, so an unset key fails closed
# rather than running the gateway open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=
